# 复制为 deploy.env 后填写
# 服务器 SSH 目标
DEPLOY_HOST=root@1.2.3.4
DEPLOY_PORT=22

# 首次部署时用于下载二进制的 Release 地址
REPO=yourname/studycheck
VERSION=v1.0.0
ASSET=studycheck-linux-amd64

# ---- 服务端运行参数（写入 systemd Environment）----
# 生产环境务必保持 SC_DEV_NO_AUTH=false
SC_DEV_NO_AUTH=false
SC_SEED_DEMO=false
SC_ALLOW_REGISTER=false
# SC_UPDATE_MANIFEST_URL=https://github.com/<owner>/<repo>/releases/latest/download/latest.json
# SC_AUTO_UPDATE=false
