# /etc/caddy/Caddyfile —— Caddy 自动申请并续期 HTTPS 证书
# 只需把域名换成你的，其余交给 Caddy

your-domain.com {
	encode zstd gzip

	# 照片：长缓存（文件名是随机 UUID，永不变更）
	@media path /media/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	# 上传大小上限（要比 SC_MAX_PHOTO_MB 略大）
	request_body {
		max_size 16MB
	}

	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
	}
}
